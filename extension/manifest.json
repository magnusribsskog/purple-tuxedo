{
  "manifest_version": 3,
  "name": "Purple Tuxedo of Shame",
  "version": "1.3.7",
  "description": "Hides low-effort Reddit comments and highlights good replies. Fixes common grammar slips on Reddit; other sites are experimental.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.reddit.com/*"
      ],
      "js": [
        "grammar-fixer.js",
        "parade.js",
        "everywhere/report.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://www.reddit.com/*"
      ],
      "js": [
        "grammar-fixer.js",
        "parade.js",
        "everywhere/report.js",
        "everywhere/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "downloads",
    "scripting"
  ],
  "background": {
    "service_worker": "everywhere/registration.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Purple Tuxedo",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
